NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://workflow:workflow@localhost:5432/workflow?schema=public
# Optional: use Prisma Accelerate instead of a direct DB connection in the app runtime.
# PRISMA_ACCELERATE_URL=https://accelerate.prisma-data.net/?api_key=...
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
